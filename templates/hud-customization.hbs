<form class="fabula-hud-config">

  <!-- COMMAND SCALE -->
  <div class="form-group">
    <label for="commandScale">Command Scale</label>

    <div class="form-fields">
      <input
        type="range"
        name="commandScale"
        id="commandScale"
        value="{{layout.command.scale}}"
        min="0.5"
        max="2"
        step="0.05"
      />

      <span class="fui-scale-value" data-scale-value="command">
        {{layout.command.scale}}
      </span>
    </div>
  </div>

  <!-- PARTY SCALE -->
  <div class="form-group">
    <label for="partyScale">Party Scale</label>

    <div class="form-fields">
      <input
        type="range"
        name="partyScale"
        id="partyScale"
        value="{{layout.party.scale}}"
        min="0.5"
        max="2"
        step="0.05"
      />

      <span class="fui-scale-value" data-scale-value="party">
        {{layout.party.scale}}
      </span>
    </div>
  </div>

  <p class="notes">
    Adjust the size of each HUD component independently.
  </p>

  <!-- POSITION -->
  <div class="form-group">
    <label>HUD Position</label>

    <div class="form-fields">
      <button type="button" data-action="edit-position">
        <i class="fas fa-arrows-alt"></i>
        Edit HUD Position
      </button>
    </div>
  </div>

  <!-- RESET -->
  <div class="form-group">
    <label>Reset</label>

    <div class="form-fields">
      <button type="button" data-action="reset-position">
        <i class="fas fa-undo"></i>
        Reset Positions
      </button>
    </div>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="submit">
      <i class="fas fa-save"></i>
      Save
    </button>
  </footer>

</form>